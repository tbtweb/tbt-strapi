{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "packages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "featured": {
      "type": "boolean"
    },
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "shortDescription": {
      "type": "text"
    },
    "description": {
      "type": "text"
    },
    "tag": {
      "type": "string"
    },
    "highlights": {
      "type": "component",
      "component": "shared.highlight",
      "repeatable": true
    },
    "whatToExpect": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "itinerary": {
      "type": "component",
      "component": "shared.itinerary-day",
      "repeatable": true
    },
    "price": {
      "type": "component",
      "component": "shared.pricing",
      "repeatable": false
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "gallary": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "days": {
      "type": "string"
    },
    "nights": {
      "type": "string"
    },
    "locations": {
      "type": "string"
    },
    "hotels": {
      "type": "component",
      "component": "shared.hotel",
      "repeatable": true
    },
    "termsAndConditions": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "ratings": {
      "type": "component",
      "component": "shared.ratings",
      "repeatable": false
    }
  }
}
